# Local dev — talk to backend directly
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Vercel + VPS (no API domain): proxy via Next.js — browser uses same HTTPS origin
# API_PROXY_TARGET="http://YOUR_VPS_IP:5080"
# NEXT_PUBLIC_API_URL="/api"

# Google Reviews — badge link on homepage testimonials carousel
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://g.page/r/your-google-business-profile

# EmailJS — enquiry form delivery (replaces backend SMTP flow on frontend)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_o0uyeqc
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_15mvmga
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key

# WhatsApp community group — footer tour updates CTA
# NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/DJGQZzmiJ02CT8uPUqtxgK

# Docker Compose (frontend service sets these automatically):
# NEXT_PUBLIC_API_URL="/api"
# API_PROXY_TARGET="http://api:5000"
# API_INTERNAL_URL="http://api:5000/api"
