# Local dev — talk to backend directly
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Vercel + VPS (no API domain): proxy via Next.js — browser uses same HTTPS origin
# API_PROXY_TARGET="http://YOUR_VPS_IP:5080"
# NEXT_PUBLIC_API_URL="/api"

# Trustindex — Google reviews widget on homepage testimonials
# Get widget ID from trustindex.io → Widgets → Save and get code → loader.js?XXXX
# NEXT_PUBLIC_TRUSTINDEX_WIDGET_ID=your-widget-id-here
# NEXT_PUBLIC_TRUSTINDEX_PROFILE_URL=https://www.trustindex.io/reviews/your-business-slug

# Docker Compose (frontend service sets these automatically):
# NEXT_PUBLIC_API_URL="/api"
# API_PROXY_TARGET="http://api:5000"
# API_INTERNAL_URL="http://api:5000/api"

# Trustindex — Google reviews widget (https://www.trustindex.io/)
# Copy widget ID from: Save and get code → loader.js?YOUR_ID
# NEXT_PUBLIC_TRUSTINDEX_WIDGET_ID=
# Optional: link for “Verified by Trustindex” badge (custom testimonials mode)
# NEXT_PUBLIC_TRUSTINDEX_PROFILE_URL=
