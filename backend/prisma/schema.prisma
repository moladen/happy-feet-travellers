// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  description        String    @db.Text
  duration           Int
  durationLabel      String?
  price              Float
  startingPrice      Float?
  departureCity      String
  destination        String?
  state              String?
  packageCategory    String?
  ctaData            Json?
  seoTitle           String?
  seoDescription     String?   @db.Text
  topicKeys          String[]  @default([])
  relatedBlogSlugs   String[]  @default([])
  landingPageSlug    String?
  tags               String[]  @default([])
  groupSize          String?
  status             String    @default("active")
  featured           Boolean   @default(false)
  seriesSlug         String?
  category           String
  subCategory        String?
  startDate          DateTime?
  endDate            DateTime?
  dateLabel          String?
  rating             Float?
  reviewsCount       Int?
  urgency            String?
  bookingDeposit     Int?
  offers             String?
  meals              String?
  stayType           String?
  transport          String?
  suitableFor        String?
  coverImage         String?
  images             String[]
  highlights         String[]
  itinerary          Json?
  inclusions         String[]
  exclusions         String[]
  faqs               Json?
  thingsToCarry      String[]
  pickupPoints       Json?
  supplements        Json?
  cancellationPolicy String?   @db.Text
  terms              Json?
  bankDetails        String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([category])
  @@index([subCategory])
  @@index([slug])
  @@index([startDate])
  @@index([status])
  @@index([featured])
  @@index([destination])
  @@index([seriesSlug])
  @@index([state])
  @@index([packageCategory])
}

model Blog {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  excerpt          String?  @db.Text
  category         String?
  content          Json
  coverImage       String
  authorName       String
  authorImage      String?
  authorInstagram  String?
  topicKeys        String[] @default([])
  relatedTourSlugs    String[] @default([])
  relatedPackageSlugs String[] @default([])
  landingPageSlug     String?
  seoTitle         String?
  seoDescription   String?  @db.Text
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String?
  image     String?
  review    String   @db.Text
  rating    Int      @default(5)
  createdAt DateTime @default(now())

  @@index([rating])
}

model LandingPage {
  id                   String   @id @default(cuid())
  title                String
  slug                 String   @unique
  status               String   @default("draft")
  heroHeading          String?
  heroSubheading       String?  @db.Text
  heroBannerImage      String?
  seasonDates          String?
  ctaButtonText        String?
  ctaButtonLink        String?
  whatsappCtaLink      String?
  whatsappGroupLink    String?
  whatsappGroupEnabled Boolean  @default(true)
  introContent         Json?
  whyVisit             Json?
  bestTimeToVisit      Json?
  destinationHighlights Json?
  fullMoonCalendar     Json?
  customBlocks         Json?
  formConfig           Json?
  seoTitle             String?
  seoDescription       String?  @db.Text
  seoKeywords          String[] @default([])
  ogImage              String?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  packages             LandingPackage[]
  faqs                 LandingFaq[]
  testimonials         LandingTestimonial[]
  enquiries            Enquiry[]

  @@index([slug])
  @@index([status])
}

model LandingPackage {
  id               String      @id @default(cuid())
  landingPageId    String
  landingPage      LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  slug             String
  name             String
  emoji            String?
  featuredImage    String?
  shortDescription String?     @db.Text
  startingPrice    String?
  duration         String?
  highlights       String[]    @default([])
  viewDetailsUrl   String?
  detailContent    Json?
  sortOrder        Int         @default(0)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([landingPageId, slug])
  @@index([landingPageId, sortOrder])
}

model LandingFaq {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  category      String      @default("travel")
  question      String
  answer        String      @db.Text
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([landingPageId, sortOrder])
}

model LandingTestimonial {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  name          String
  city          String?
  image         String?
  review        String      @db.Text
  rating        Int         @default(5)
  sortOrder     Int         @default(0)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([landingPageId, sortOrder])
}

model Enquiry {
  id                       String       @id @default(cuid())
  name                     String
  phone                    String
  email                    String
  message                  String       @db.Text
  source                   String?
  subject                  String?
  travellerType            String?
  travelInsuranceRequested Boolean      @default(false)
  status                   String       @default("new")
  landingPageId            String?
  landingPage              LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  createdAt                DateTime     @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([landingPageId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  altText   String
  category  String?
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model HeroSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String
  tag       String?
  emoji     String?  @default("✨")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model TeamMember {
  id            String   @id @default(cuid())
  fullName      String
  role          String
  bio           String   @db.Text
  instagramUrl  String?
  linkedinUrl   String?
  imageUrl      String
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
}

model SiteSettings {
  id             String   @id @default("site-settings")
  whatsappNumber String?
  email          String?
  instagramUrl   String?
  facebookUrl    String?
  youtubeUrl     String?
  officeAddress  String?  @db.Text
  paymentLink    String?
  footerTagline  String?
  footerDetails  String?  @db.Text
  termsContent              String?  @db.Text
  privacyContent            String?  @db.Text
  cancellationPolicyContent String?  @db.Text
  policiesLastUpdated       String?
  heroCommunityQuote        String?  @db.Text
  heroCommunityBannerUrl    String?
  heroCommunityAvatars      String?  @db.Text
  seasonPromoActive         Boolean  @default(true)
  seasonPromoBadge          String?
  seasonPromoEyebrow        String?
  seasonPromoTitle          String?
  seasonPromoSubtitle       String?
  seasonPromoDescription    String?  @db.Text
  seasonPromoImageUrl       String?
  seasonPromoTags           String?  @db.Text
  seasonPromoPrimaryCtaLabel   String?
  seasonPromoPrimaryCtaHref    String?
  seasonPromoSecondaryCtaLabel String?
  seasonPromoSecondaryCtaHref  String?
  aboutPageContent             String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
