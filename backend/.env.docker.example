# Copy to .env when using docker compose (backend folder):
#   cp .env.docker.example .env

# Postgres (docker-compose postgres service)
POSTGRES_USER=happy_feet
POSTGRES_PASSWORD=happy_feet
POSTGRES_DB=happy_feet
POSTGRES_PORT=5434

# API
API_PORT=5000
NODE_ENV=production

# DATABASE_URL is set automatically in docker-compose.yml (host: postgres)
# For local dev without Docker, use:
# DATABASE_URL=postgresql://happy_feet:happy_feet@localhost:5434/happy_feet

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d

ADMIN_EMAIL=admin@happyfeet.com
ADMIN_PASSWORD=Admin@123

CORS_ORIGINS=http://localhost:3000
# Allow any https://*.vercel.app origin (preview + production deploys)
CORS_ALLOW_VERCEL=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

RUN_MIGRATIONS=true
# Set true once on a fresh DB to load sample tours, blogs, etc. (re-seeding wipes existing CMS data)
RUN_SEED=false

# Enquiry emails: configure EmailJS in frontend env (not backend SMTP).
