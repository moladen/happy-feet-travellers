# Copy for local DEMO testing (no Gmail App Password required):
#   copy .env.demo .env   (Windows)
# Then merge with your DATABASE_URL and JWT_SECRET from existing .env

DATABASE_URL="postgresql://postgres:password@localhost:5434/happy_feet"
PORT=5000
NODE_ENV=development
JWT_SECRET="demo_jwt_secret_change_me"
JWT_EXPIRY="7d"
ADMIN_EMAIL="admin@happyfeet.com"
ADMIN_PASSWORD="Admin@123"

# ===== DEMO EMAIL (no SMTP password) =====
# "To" address shown on the email (preview only until real SMTP is set)
ENQUIRY_NOTIFY_EMAIL="demo@happyfeet.com"
MAIL_FROM="Happy Feet Travellers <demo@happyfeet.com>"

# Leave empty — Ethereal test SMTP is used automatically
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

SMTP_DEV_ETHEREAL=true
SMTP_VERIFY_ON_START=false
