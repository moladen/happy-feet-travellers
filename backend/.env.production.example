# Copy to backend/.env on your VPS. Do not commit real secrets.

NODE_ENV=production
PORT=5000

# Docker Compose on VPS (postgres service hostname = postgres):
DATABASE_URL="postgresql://happy_feet:CHANGE_ME@postgres:5432/happy_feet"

JWT_SECRET="CHANGE_ME_LONG_RANDOM"
JWT_EXPIRY="7d"

ADMIN_EMAIL="admin@happyfeet.com"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_GO_LIVE"

# Vercel frontend (required). Add custom domains when you attach them.
CORS_ORIGINS="https://happy-feet-travellers-frontend.vercel.app"
CORS_ALLOW_VERCEL=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

ENQUIRY_NOTIFY_EMAIL="info@happyfeet.com"
MAIL_FROM="Happy Feet Travellers <noreply@happyfeet.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_VERIFY_ON_START=true

RUN_MIGRATIONS=true
RUN_SEED=false

# Docker Compose postgres (optional overrides)
POSTGRES_USER=happy_feet
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=happy_feet
