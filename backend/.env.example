# Database
DATABASE_URL="postgresql://user:password@localhost:5432/happy_feet_db"
#
# Neon / cloud: paste the full URL from the Neon dashboard; use `?sslmode=require` (or `&sslmode=require` if the URL already has `?`).
# P1001 "Can't reach database server": wait ~30s and retry (Neon may be waking); add `&connect_timeout=30` to the URL;
# allow outbound TCP 5432 in firewall/VPN; try Neon’s pooled connection string (host contains `-pooler`) if direct fails.

# Server
PORT=5000
# If you see EADDRINUSE / "address already in use", pick another port (e.g. 5001) or stop the old node process.
NODE_ENV=development

# JWT
JWT_SECRET="your_super_secret_jwt_key_change_in_production"
JWT_EXPIRY="7d"

# Admin Credentials (used for first-time admin auto-provisioning)
ADMIN_EMAIL="admin@happyfeet.com"
ADMIN_PASSWORD="Admin@123"

# CORS — comma separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Enquiry email notifications (Nodemailer + SMTP — Brevo, Resend SMTP, Gmail, etc.)
# Company receives an email on every contact form submission.
ENQUIRY_NOTIFY_EMAIL="info@happyfeet.com"
MAIL_FROM="Happy Feet Travellers <noreply@happyfeet.com>"

# SMTP (Brevo example: smtp-relay.brevo.com, port 587, SMTP_SECURE=false)
# Resend SMTP: smtp.resend.com, user "resend", pass = API key
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# Set true to verify SMTP when the server starts (recommended in production)
SMTP_VERIFY_ON_START=false
